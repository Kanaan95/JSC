# PostgreSQL connection string used by Payload's db-postgres adapter.
# Local development matches the docker-compose.yml Postgres 16 service below.
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/jsc-main

# Secret used by Payload to sign JWTs and encrypt sensitive data.
# Generate a strong value, e.g.: openssl rand -base64 32
PAYLOAD_SECRET=
